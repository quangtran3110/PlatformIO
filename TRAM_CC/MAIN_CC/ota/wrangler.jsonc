{
  "$schema": "https://developers.cloudflare.com/workers/wrangler/config-schema.json",
  "name": "tram-cc-private-ota",
  "main": "worker/src/index.js",
  "compatibility_date": "2026-09-28",
  "workers_dev": true,
  "kv_namespaces": [
    {
      "binding": "FIRMWARE",
      "id": "6ecf40bae5aa4100993dbb4ffba66865"
    }
  ],
  "secrets": {
    "required": ["TRAM_CC_OTA_KEY", "TRAM_SO_2_OTA_KEY"]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1,
    "logs": {
      "invocation_logs": false
    }
  }
}
